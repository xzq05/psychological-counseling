# .env.example - 复制为 .env 并填写真实值

# ===== MongoDB Atlas =====
# 格式: mongodb+srv://<用户名>:<密码>@<集群地址>/<数据库名>?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/psychological_counseling?retryWrites=true&w=majority
MONGODB_DB=psychological_counseling

# ===== Redis Cloud =====
# 格式: redis-xxxxx.<region>.cache.amazonaws.com 或 redis.cloud.com
REDIS_HOST=your-redis-host.rediscloud.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 应用 =====
DEBUG=false